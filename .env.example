# Local development. `cp .env.example .env` is optional: with no .env at all the app behaves
# exactly like this file. See README.md.
#
# Nothing here is a secret. Vite exposes every VITE_* value to the browser bundle, so never put a
# credential in a variable with that prefix.

# Where the browser sends API calls. A RELATIVE path goes through the Vite dev server's proxy
# (below), so there is no CORS to configure and cookies stay same-origin. An absolute URL
# (e.g. http://localhost:8000/api/v1) is cross-origin: it only works from an origin the backend's
# CORS_ORIGINS lists (http://localhost:5173 by default). A PRODUCTION build requires this to be set.
VITE_API_BASE_URL=/api/v1

# Where the dev server proxies /api. The default is the backend from qnsc-kb-backend's compose
# stack. Uncomment to point at another backend (a teammate's, or a deployed develop).
# VITE_DEV_API_TARGET=http://localhost:8000

# The dev server's port (default 5173). Pinned: a taken port fails the start rather than moving, because the backend's
# CORS_ORIGINS and the sign-in cookie are set for this origin. A second copy of the stack sets its own port here and
# points VITE_DEV_API_TARGET at its backend (README → "Run a second copy"). Not VITE_-prefixed on purpose: the browser
# bundle does not need it.
# FRONTEND_DEV_PORT=5173
